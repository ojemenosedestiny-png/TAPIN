# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Termii SMS (Stage 4)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Shared secret for Vercel Cron → /api/cron/* (Stage 4)
CRON_SECRET=

# Set to 1 to run the RLS integration test (npm run test:rls). Use a dev project, never production.
RUN_RLS_TESTS=
