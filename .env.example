# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Termii SMS (Stage 4)
TERMII_API_KEY=
TERMII_SENDER_ID=
# From your Termii dashboard. dnd = transactional route that reaches DND numbers (ask Termii support to enable); generic = promotional.
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=dnd

# WhatsApp (optional): Termii device + one approved template per alert type.
# Placeholders: {{1}} child's name, {{2}} school, {{3}} time or date, {{4}} reason. OTP template uses {{otp}}.
TERMII_WHATSAPP_DEVICE_ID=
TERMII_WA_TEMPLATE_ARRIVAL=
TERMII_WA_TEMPLATE_DEPARTURE=
TERMII_WA_TEMPLATE_LATE=
TERMII_WA_TEMPLATE_ABSENCE=
TERMII_WA_TEMPLATE_EARLY=
TERMII_WA_TEMPLATE_SUMMARY=
TERMII_WA_TEMPLATE_OTP=

# Parent portal: Supabase Auth → Hooks → Send SMS hook secret ("v1,whsec_...")
SEND_SMS_HOOK_SECRET=

# Shared secret for scheduled jobs → /api/cron/* (32+ random characters)
CRON_SECRET=

# Set to 1 to run the RLS integration test (npm run test:rls). Use a dev project, never production.
RUN_RLS_TESTS=
