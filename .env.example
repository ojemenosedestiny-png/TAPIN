# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Termii SMS (Stage 4)
TERMII_API_KEY=
TERMII_SENDER_ID=
# From your Termii dashboard. dnd = transactional route that reaches DND numbers (ask Termii support to enable); generic = promotional.
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=dnd

# WhatsApp (optional): Termii device + one approved template per alert type.
# Placeholders: {{1}} child's name, {{2}} school, {{3}} time or date, {{4}} reason. The OTP template uses {{1}} for the code.
# Without TERMII_SENDER_ID, alerts and sign-in codes all go by WhatsApp.
TERMII_WHATSAPP_DEVICE_ID=
TERMII_WA_TEMPLATE_ARRIVAL=
TERMII_WA_TEMPLATE_DEPARTURE=
TERMII_WA_TEMPLATE_LATE=
TERMII_WA_TEMPLATE_ABSENCE=
# WhatsApp assistant for parents: replies are sent from this WhatsApp sender on Termii (falls back to TERMII_SENDER_ID).
TERMII_WHATSAPP_FROM=
# Secret in the webhook address you give Termii (or Meta): https://<site>/api/whatsapp/inbound?key=<this>. 16+ characters.
WHATSAPP_INBOUND_SECRET=
# Meta WhatsApp Cloud API (used instead of Termii for WhatsApp when set). Token: system user, never expires.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Approved templates for alerts: name, or name:N for N placeholders ({{1}} child, {{2}} school, {{3}} time/date, {{4}} reason).
WHATSAPP_TEMPLATE_ARRIVAL=
WHATSAPP_TEMPLATE_DEPARTURE=
WHATSAPP_TEMPLATE_LATE=
WHATSAPP_TEMPLATE_ABSENCE=
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_LANG=en
TERMII_WA_TEMPLATE_EARLY=
TERMII_WA_TEMPLATE_SUMMARY=
TERMII_WA_TEMPLATE_OTP=

# Parent portal: Supabase Auth → Hooks → Send SMS hook secret ("v1,whsec_...")
SEND_SMS_HOOK_SECRET=

# Shared secret for scheduled jobs → /api/cron/* (32+ random characters)
CRON_SECRET=

# Set to 1 to run the RLS integration test (npm run test:rls). Use a dev project, never production.
RUN_RLS_TESTS=

# Kiosk voice (optional). Without a key, the kiosk uses the device voice.
ELEVENLABS_API_KEY=
# Defaults to the TapIn school voice.
ELEVENLABS_VOICE_ID=jlik6FLVd8mjNUzqTLQ3
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Online payments on the pricing page (Flutterwave). Without the key, orders are saved for an invoice instead.
FLW_SECRET_KEY=
# The "secret hash" you set in Flutterwave -> Settings -> Webhooks (webhook URL: https://<your-app>/api/flutterwave/webhook)
FLW_SECRET_HASH=
